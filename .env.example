# Copy to .env locally. Do not commit credentials.
OPENROUTER_API_KEY=
# Jev is paid. Debate and Hermes default to exact :free models; no paid fallback.
OPENROUTER_JEV_MODEL=typesafe/jev-1.14
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Choose a feed you are entitled to use (iex or sip).
ALPACA_DATA_FEED=iex
# Actual Hermes runtime; python setup_integrations.py --install-hermes prepares it.
HERMES_SOURCE=
HERMES_PYTHON=
# A random shared token for the OpenBot AG-UI connection; not an OpenRouter key.
JEVIE_AGENT_TOKEN=
# Optional real-money mode. Separate credentials; CLI confirmation also required.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
JEVIE_ENABLE_LIVE=
# Bundled OpenBot fork. Supabase Connect > Session pooler, port 5432.
# PostgreSQL connection string, not the Supabase HTTPS project URL or API key.
# No CopilotKit Intelligence key, license or subscription is required.
DATABASE_URL=
